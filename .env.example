# Copy this file to .env and fill in real values for local dev / production.

# --- Database ---
# Local dev: SQLite file in the repo root.
# Production: Postgres (Neon) — postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:///./dev.db

# --- API auth ---
# Generate a JWT signing secret (any long random string)
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string

# Admin login (single user). Store the BCRYPT HASH, not the password.
# Generate the hash:
#   uv run python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$change-me-to-a-real-bcrypt-hash

# --- Email (Resend) ---
# Leave RESEND_API_KEY blank in dev: emails will be logged to stdout instead of sent.
RESEND_API_KEY=
RESEND_FROM=alerts@example.com

# --- URLs ---
# Where the web frontend lives (used in confirm/unsub redirects and email links)
WEB_BASE_URL=http://localhost:3000

# Where the API lives (used by the scraper to call /admin/alerts/dispatch)
API_BASE=http://localhost:8000

# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000

# --- Scraper ---
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/127.0.0.0 Safari/537.36
